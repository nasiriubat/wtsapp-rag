POSTGRES_PASSWORD=change-me

# The one group the bot listens to, e.g. 120363012345678901@g.us.
# Leave empty on first run: the gateway logs the JID of every group it sees.
GROUP_JID=

# Where the gateway POSTs messages. Inside compose the app service is "app".
APP_URL=http://app:8000

# Message prefixes that trigger an answer, comma-separated, case-insensitive.
# A real @mention of the bot's number and replies to its messages always trigger.
TRIGGERS=@agent
