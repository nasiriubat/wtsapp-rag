# Only what must exist before the database does. Everything the admin owns
# (groups, providers, channels, triggers, thresholds, budgets, retention) is
# set in the panel at http://localhost:8000/admin and stored in Postgres.
#
# Copy to .env and fill in. .env is gitignored; keep it out of the repo and
# back it up with the database, because SECRET_KEY is the only thing that can
# decrypt the provider keys and channel tokens in a dump.

# Postgres. Set once, before the first start: it is baked into the data volume.
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=

# Encrypts provider keys and channel tokens at rest, signs the admin session
# and derives its CSRF token. Generate: openssl rand -hex 32
SECRET_KEY=

# First admin login at /admin. The user name is "admin".
ADMIN_PASSWORD=

# Shared between the app and the gateway. Anything holding this can read every
# channel token, so treat it like one. Generate: openssl rand -hex 32
GATEWAY_TOKEN=

# Where the gateway reaches the app. Inside compose the app service is "app".
APP_URL=http://app:8000

# Port the WhatsApp Cloud API channel listens on for Meta's webhook. Only that
# channel uses it, and only when you enable it. Default 8080.
#GATEWAY_PORT=8080

# Optional. Read once, on the first start with an empty database, and turned
# into provider rows. After that they are ignored: manage providers in the
# panel, where you also set their prices, which start at 0.
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
#OPENAI_API_KEY=
#OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional, only when upgrading a v0.1 install. Read once, on the first start
# with no groups, to recreate the single group that used to live here. New
# installs enable groups in the setup wizard instead.
#GROUP_JID=
#TRIGGERS=@agent
