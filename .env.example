# Only what must exist before the database does. Everything else (groups,
# providers, triggers, thresholds, budgets) is set in the admin panel.

POSTGRES_PASSWORD=change-me

# Encrypts provider keys and channel tokens at rest. Generate: openssl rand -hex 32
SECRET_KEY=

# First admin login. User name is "admin".
ADMIN_PASSWORD=change-me

# Shared between the app and the gateway process. Generate: openssl rand -hex 32
GATEWAY_TOKEN=

# Where the gateway reaches the app. Inside compose the app service is "app".
APP_URL=http://app:8000

# Optional shortcuts, read once on first start with an empty database and
# turned into provider rows (and a group). After that they are ignored; manage
# providers in the admin. Prices start at 0 until you set them there.
#GEMINI_API_KEY=
#OPENAI_API_KEY=
#OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#GROUP_JID=
#TRIGGERS=@agent
#CONFIDENCE_THRESHOLD=0.1
